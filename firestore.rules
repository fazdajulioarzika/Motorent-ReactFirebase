rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isStaff() {
      return request.auth != null &&
        get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role in ['super_admin','admin','staff'];
    }
    match /motorTypes/{id} {
      allow read: if resource.data.isActive == true || isStaff();
      allow write: if isStaff();
    }
    match /settings/public {
      allow read: if true;
      allow write: if isStaff();
    }
    match /reviews/{id} {
      allow read: if resource.data.isApproved == true;
      allow write: if isStaff();
    }
    match /{col}/{id} {
      allow read, write: if isStaff();
    }
  }
}
